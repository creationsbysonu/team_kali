# Docker Environment Variables
# Copy this file to .env.docker for Docker deployments

# Django
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database (use Docker service names)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db  # Docker service name
DB_PORT=5432

# Redis (use Docker service name)
REDIS_HOST=redis  # Docker service name, defaults to 'localhost' for local dev
REDIS_PORT=6379

# Email
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# JWT
JWT_COOKIE_SECURE=True  # Set to True in production with HTTPS
